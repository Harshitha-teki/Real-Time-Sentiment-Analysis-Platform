# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_USER=sentiment_user
POSTGRES_PASSWORD=secure_pass_123
POSTGRES_DB=sentiment_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CRITICAL: Must use +asyncpg for the AsyncSession in database.py
DATABASE_URL=postgresql+asyncpg://sentiment_user:secure_pass_123@db:5432/sentiment_db

# ==========================================
# Message Queue Configuration (Redis)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_STREAM_NAME=social_posts_stream
REDIS_CONSUMER_GROUP=sentiment_workers
REDIS_CACHE_PREFIX=sentiment_cache

# ==========================================
# AI Model Configuration
# ==========================================
# Local HuggingFace Models
HUGGINGFACE_MODEL=distilbert-base-uncased-finetuned-sst-2-english
EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base

# External LLM (Groq/Llama)
EXTERNAL_LLM_PROVIDER=groq
EXTERNAL_LLM_API_KEY=gsk_your_actual_key_here
EXTERNAL_LLM_MODEL=llama-3.1-8b-instant

# ==========================================
# API & Infrastructure Configuration
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# ==========================================
# Alert & Analysis Thresholds
# ==========================================
ALERT_NEGATIVE_RATIO_THRESHOLD=2.0
ALERT_WINDOW_MINUTES=5
ALERT_MIN_POSTS=10